rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /officers/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /branding/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /gallery/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /motm/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /events/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /resources/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /reports/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
