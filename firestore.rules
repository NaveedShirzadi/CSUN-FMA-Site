rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isEditor() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/editors/$(request.auth.token.email.lower()));
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /officers/{officerId} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /membership/{tierId} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /resources/{resourceId} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /socials/{socialId} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /offerings/{offeringId} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /gallery/{photoId} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /weeklyReports/{reportId} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /joinFields/{fieldId} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /joinResponses/{responseId} {
      allow create: if true;
      allow read, delete: if isEditor();
      allow update: if isEditor();
    }
    match /tutoringRequests/{requestId} {
      allow create: if true;
      allow read, delete: if isEditor();
    }
    match /visits/{visitId} {
      allow create: if request.resource.data.keys().hasOnly(['day', 'visitor', 'tab', 'at'])
        && request.resource.data.keys().hasAll(['day', 'visitor', 'tab', 'at'])
        && request.resource.data.day is string && request.resource.data.day.size() == 10
        && request.resource.data.visitor is string && request.resource.data.visitor.size() <= 40
        && request.resource.data.tab is string && request.resource.data.tab.size() <= 30
        && request.resource.data.at == request.time;
      allow read, delete: if isEditor();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isEditor();
    }
    match /editors/{email} {
      allow read: if request.auth != null;
      allow write: if isEditor();
    }
  }
}
